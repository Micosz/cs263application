# คัดลอกเป็น .env.local สำหรับรันในเครื่อง:  cp .env.example .env.local
# บน Vercel ให้กรอกค่าเดียวกันที่ Project → Settings → Environment Variables
# [server] = ใช้เฉพาะฝั่ง server ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit ค่าจริง
# [public] = ถูกฝังในโค้ดฝั่งเบราว์เซอร์ (ไม่ใช่ความลับ) ต้อง redeploy หลังเปลี่ยนค่า

# ---------- ฐานข้อมูล ----------
# [server][ลับ] PostgreSQL connection string
#   ในเครื่อง: ใช้ค่าด้านล่าง (docker compose up -d)
#   บน Vercel: Storage → Neon (Postgres) → Connect Project แล้วระบบจะเติม DATABASE_URL ให้ (ใช้แบบ pooled)
DATABASE_URL=postgres://asset:asset@localhost:5433/asset_tracker
# [server] จำนวน connection สูงสุดต่อ instance (ไม่ใส่ = 5)
# DATABASE_POOL_MAX=5
# [เฉพาะเครื่อง] ฐานข้อมูลแยกสำหรับ npm test (ถูกล้างทุกครั้ง ชื่อต้องลงท้าย _test)
DATABASE_URL_TEST=postgres://asset:asset@localhost:5433/asset_tracker_test

# ---------- เว็บและ session ----------
# [server][ลับ] สุ่มยาวอย่างน้อย 32 ตัว เช่น  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# [server] URL หลักของเว็บ ไม่มี / ท้าย ใช้สร้าง Callback URL ของ LINE Login และลิงก์ในข้อความ LINE
#   ในเครื่อง: http://localhost:3000   บน Vercel: https://<ชื่อโปรเจกต์>.vercel.app
APP_BASE_URL=http://localhost:3000

# ---------- LINE Login (เข้าสู่ระบบบนเว็บ + LIFF) ----------
# ที่มา: LINE Developers Console → Provider → LINE Login channel → Basic settings
# [server] Channel ID (ใช้ตรวจ ID token กับ LINE ทั้งจากเว็บและ LIFF)
LINE_LOGIN_CHANNEL_ID=
# [server][ลับ] Channel secret
LINE_LOGIN_CHANNEL_SECRET=
# [public] LINE Login channel → แท็บ LIFF → LIFF ID (รูปแบบ 1234567890-AbCdEfGh)
NEXT_PUBLIC_LIFF_ID=

# ---------- LINE Messaging API (ส่งข้อความจาก LINE Official Account) ----------
# ที่มา: LINE Developers Console → Provider เดียวกัน → Messaging API channel
# [server][ลับ] แท็บ Messaging API → Channel access token (long-lived) → Issue
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# [server][ลับ] แท็บ Basic settings → Channel secret (ใช้ตรวจลายเซ็น webhook /api/line/webhook)
LINE_MESSAGING_CHANNEL_SECRET=
